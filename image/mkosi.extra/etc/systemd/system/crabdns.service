[Unit]
Description=CrabDNS Frontline Filtering & Encrypted DNS Service
After=network-online.target dnsmasq.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/crabdns --config /run/crabrouter/crabdns.toml
Restart=always
RestartSec=2
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
