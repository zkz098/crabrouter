[Unit]
Description=CrabRouter Control Plane Daemon
After=network-pre.target systemd-udev-settle.service crabrouter-etc-overlay.service
Before=network.target
Wants=network-pre.target

[Service]
Type=notify
WatchdogSec=30s
ExecStart=/usr/local/bin/crabrouterd --config /var/lib/crabrouter/router.toml
Restart=always
RestartSec=2
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_RAWIO CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID CAP_KILL CAP_SYS_BOOT CAP_SYS_TTY_CONFIG CAP_AUDIT_WRITE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
