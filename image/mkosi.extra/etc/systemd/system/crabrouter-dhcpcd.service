[Unit]
Description=CrabRouter WAN DHCP/DHCPv6-PD Client (dhcpcd)
After=crabrouterd.service network-pre.target
Requires=crabrouterd.service
ConditionPathExists=/etc/dhcpcd.d/crabrouter.conf

[Service]
Type=simple
ExecStart=/usr/sbin/dhcpcd -B -f /etc/dhcpcd.d/crabrouter.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
